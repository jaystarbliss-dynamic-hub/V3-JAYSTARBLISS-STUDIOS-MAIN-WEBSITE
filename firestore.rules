rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuth() { return request.auth != null; }
    function isAdminEmail() { 
      return isAuth() && request.auth.token.email != null && (
        request.auth.token.admin == true || 
        request.auth.token.isAdmin == true || 
        request.auth.token.email == 'johnrufai242@gmail.com' || 
        request.auth.token.email == 'admin@jaystarbliss.com' || 
        request.auth.token.email == 'admin@jaystar.com'
      ); 
    }
    function isActiveUserRecord() { 
      return isAuth() && (
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid))) || 
        isAdminEmail() || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
          !(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('accountStatus', 'ACTIVE') in ['DISABLED', 'SUSPENDED', 'BANNED']) && 
          !(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('status', 'ACTIVE') in ['DISABLED', 'SUSPENDED', 'BANNED']))
      ); 
    }
    function isSuperAdmin() { 
      return isAuth() && (
        isAdminEmail() || 
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid))) || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') in ['SUPER_ADMIN', 'super_admin', 'ADMIN', 'admin'])
      ); 
    }
    function isPrivilegedRole(role) {
      return role in [
        'SUPER_ADMIN','super_admin','SUPERADMIN','superadmin',
        'ADMIN','admin','CONTENT_ADMIN','content_admin',
        'EDUCATION_ADMIN','education_admin','SERVICES_ADMIN','services_admin',
        'MARKETING_ADMIN','marketing_admin','SUPPORT_ADMIN','support_admin',
        'FINANCE_ADMIN','finance_admin','DIRECTOR','director'
      ];
    }
    function isSelfRegistrationRole(role) {
      return role in [
        'STUDENT','student','INDIVIDUAL_STUDENT','individual_student',
        'PARENT','parent','CLIENT','client',
        'STAFF','staff','TUTOR','tutor','INSTRUCTOR','instructor','FACULTY','faculty','TEACHER','teacher',
        'USER','user'
      ];
    }
    function isAnyAdmin() { 
      return isAuth() && (
        isAdminEmail() || 
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid))) || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') in ['SUPER_ADMIN','super_admin','SUPERADMIN','superadmin','ADMIN','admin','CONTENT_ADMIN','content_admin','EDUCATION_ADMIN','education_admin','SERVICES_ADMIN','services_admin','MARKETING_ADMIN','marketing_admin','SUPPORT_ADMIN','support_admin','FINANCE_ADMIN','finance_admin','director','DIRECTOR'])
      ); 
    }
    function isNotificationAdmin() {
      return isAuth() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') in ['SUPER_ADMIN','super_admin','SUPERADMIN','superadmin','ADMIN','admin']) ||
        (request.auth.token.email != null && request.auth.token.email in ['johnrufai242@gmail.com','admin@jaystarbliss.com','admin@jaystar.com'])
      );
    }
    function notificationTargetRoleMatches(targetRole) {
      // Broadcasts must explicitly name their audience. Missing/empty roles
      // are not a public broadcast and must never match every signed-in user.
      return targetRole == 'all' ||
        (isAuth() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          (
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == targetRole ||
            (targetRole == 'student' && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') in ['STUDENT', 'student']) ||
            (targetRole == 'parent' && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') in ['PARENT', 'parent']) ||
            (targetRole == 'school' && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') in ['SCHOOL', 'school', 'SCHOOL_ADMIN', 'school_admin', 'schoolAdmin', 'SCHOOLADMIN', 'institution', 'INSTITUTION']) ||
            (targetRole == 'staff' && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') in ['STAFF', 'staff', 'TUTOR', 'tutor', 'INSTRUCTOR', 'instructor']) ||
            (targetRole == 'admin' && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') in ['ADMIN', 'admin', 'SUPER_ADMIN', 'super_admin', 'SUPERADMIN', 'superadmin'])
          ));
    }
    function isTutorOrSuperAdmin() {
      return isAuth() && (
        isSuperAdmin() ||
        isStaffOrTutor()
      );
    }
    function isStaffOrTutor() { 
      return isAuth() && (
        isAnyAdmin() || 
        exists(/databases/$(database)/documents/tutors/$(request.auth.uid)) ||
        exists(/databases/$(database)/documents/staff/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') in ['STAFF','staff','TUTOR','tutor','instructor','INSTRUCTOR','FACULTY','faculty','TEACHER','teacher'])
      ); 
    }
    function hasStaffSchoolAccess(schoolId) { 
      return isAuth() && schoolId != null && (
        isAnyAdmin() || 
        (isStaffOrTutor() && exists(/databases/$(database)/documents/staffSchoolAccess/$(request.auth.uid)) && (
          get(/databases/$(database)/documents/staffSchoolAccess/$(request.auth.uid)).data.get('schoolId', null) == schoolId || 
          (get(/databases/$(database)/documents/staffSchoolAccess/$(request.auth.uid)).data.get('schoolIds', []) is list && schoolId in get(/databases/$(database)/documents/staffSchoolAccess/$(request.auth.uid)).data.get('schoolIds', []))
        ))
      ); 
    }
    function isSchoolUser() { 
      return isAuth() && (
        isAnyAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') in ['SCHOOL','school','SCHOOL_ADMIN','school_admin','schoolAdmin','SCHOOLADMIN','institution','INSTITUTION']) ||
        exists(/databases/$(database)/documents/schools/$(request.auth.uid))
      ); 
    }
    function userSchoolId() { 
      return isAuth() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) 
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('schoolId', get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('school_id', get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('schoolDocId', null)))
        : null; 
    }
    function isSameSchool(schoolId) {
      return isAuth() && schoolId != null && schoolId != '' && (
        isSuperAdmin() ||
        schoolId == request.auth.uid ||
        schoolId == userSchoolId() ||
        (exists(/databases/$(database)/documents/schools/$(schoolId)) && (
          get(/databases/$(database)/documents/schools/$(schoolId)).data.get('email', '') == request.auth.token.email ||
          get(/databases/$(database)/documents/schools/$(schoolId)).data.get('contactEmail', '') == request.auth.token.email ||
          get(/databases/$(database)/documents/schools/$(schoolId)).data.get('adminUid', '') == request.auth.uid ||
          get(/databases/$(database)/documents/schools/$(schoolId)).data.get('firebaseUid', '') == request.auth.uid ||
          get(/databases/$(database)/documents/schools/$(schoolId)).data.get('userId', '') == request.auth.uid
        )) || hasStaffSchoolAccess(schoolId)
      );
    }
    function isOwnStudent(data) { return isAuth() && (data.get('firebaseUid', '') == request.auth.uid || data.get('userId', '') == request.auth.uid); }
    function isOwnParent(data) { return isAuth() && (data.get('parentId', '') == request.auth.uid || data.get('userId', '') == request.auth.uid || data.get('firebaseUid', '') == request.auth.uid); }
    function isParentOfStudent(studentId) { return isAuth() && exists(/databases/$(database)/documents/individualStudents/$(studentId)) && get(/databases/$(database)/documents/individualStudents/$(studentId)).data.parentId == request.auth.uid; }
    function isOwnLearner(studentId) { return isAuth() && ((exists(/databases/$(database)/documents/individualStudents/$(studentId)) && (get(/databases/$(database)/documents/individualStudents/$(studentId)).data.firebaseUid == request.auth.uid || get(/databases/$(database)/documents/individualStudents/$(studentId)).data.userId == request.auth.uid)) || (exists(/databases/$(database)/documents/students/$(studentId)) && (get(/databases/$(database)/documents/students/$(studentId)).data.firebaseUid == request.auth.uid || get(/databases/$(database)/documents/students/$(studentId)).data.userId == request.auth.uid))); }
    function isAssignedStaffToStudent(studentId) { return isStaffOrTutor() && ((exists(/databases/$(database)/documents/individualStudents/$(studentId)) && (get(/databases/$(database)/documents/individualStudents/$(studentId)).data.tutorId == request.auth.uid || get(/databases/$(database)/documents/individualStudents/$(studentId)).data.staffId == request.auth.uid || get(/databases/$(database)/documents/individualStudents/$(studentId)).data.assignedTutorId == request.auth.uid || get(/databases/$(database)/documents/individualStudents/$(studentId)).data.assignedStaffId == request.auth.uid || get(/databases/$(database)/documents/individualStudents/$(studentId)).data.instructorId == request.auth.uid)) || (exists(/databases/$(database)/documents/students/$(studentId)) && (get(/databases/$(database)/documents/students/$(studentId)).data.tutorId == request.auth.uid || get(/databases/$(database)/documents/students/$(studentId)).data.staffId == request.auth.uid || get(/databases/$(database)/documents/students/$(studentId)).data.assignedTutorId == request.auth.uid || get(/databases/$(database)/documents/students/$(studentId)).data.assignedStaffId == request.auth.uid || get(/databases/$(database)/documents/students/$(studentId)).data.instructorId == request.auth.uid))); }

    match /users/{userId} {
      allow read: if isAuth() || true;
      allow create: if isSuperAdmin() ||
        (isAnyAdmin() && !isPrivilegedRole(request.resource.data.get('role', ''))) ||
        (isSchoolUser() && !isPrivilegedRole(request.resource.data.get('role', '')) && isSameSchool(request.resource.data.get('schoolId', null))) ||
        (isAuth() && request.auth.uid == userId && !isPrivilegedRole(request.resource.data.get('role', '')) &&
          !request.resource.data.keys().hasAny(['isAdmin', 'admin', 'permissions']));
      allow update: if isSuperAdmin() ||
        (isAnyAdmin() &&
          !isPrivilegedRole(request.resource.data.get('role', '')) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isAdmin','admin','permissions'])) ||
        (isSchoolUser() &&
          isSameSchool(resource.data.get('schoolId', request.resource.data.get('schoolId', null))) &&
          isSameSchool(request.resource.data.get('schoolId', null)) &&
          !isPrivilegedRole(request.resource.data.get('role', '')) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isAdmin','admin','permissions'])) ||
        (isAuth() && request.auth.uid == userId &&
          !isPrivilegedRole(request.resource.data.get('role', '')) &&
          !(resource.data.get('accountStatus', 'ACTIVE') in ['DISABLED', 'SUSPENDED', 'BANNED']) &&
          !(resource.data.get('status', 'ACTIVE') in ['DISABLED', 'SUSPENDED', 'BANNED']) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isAdmin','admin','permissions']));
      allow delete: if isSuperAdmin();
    }
    match /admins/{userId} {
      allow read: if isAnyAdmin() || (isAuth() && request.auth.uid == userId);
      // Only a Super Admin may grant or revoke administrator records.
      allow write: if isSuperAdmin();
    }
    match /invites/{email} { allow read: if isAnyAdmin() || (isAuth() && request.auth.token.email != null && request.auth.token.email.lower() == email.lower()); allow write: if isAnyAdmin(); allow delete: if isAnyAdmin() || (isAuth() && request.auth.token.email != null && request.auth.token.email.lower() == email.lower()); }

    match /individualStudents/{studentId} {
      allow read: if true;
      allow create: if isAnyAdmin() ||
        (isSchoolUser() && isSameSchool(request.resource.data.get('schoolId', null))) ||
        (isStaffOrTutor() && (isAssignedStaffToStudent(studentId) || hasStaffSchoolAccess(request.resource.data.get('schoolId', null))));
      allow update: if isAnyAdmin() ||
        (isSchoolUser() && isSameSchool(resource.data.get('schoolId', request.resource.data.get('schoolId', null)))) ||
        (isStaffOrTutor() && (isAssignedStaffToStudent(studentId) || hasStaffSchoolAccess(resource.data.get('schoolId', null)))) ||
        (isAuth() && (
          resource.data.get('firebaseUid', '') == request.auth.uid ||
          resource.data.get('userId', '') == request.auth.uid ||
          studentId == request.auth.uid ||
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('studentDocId', '') == studentId)
        )) ||
        (isAuth() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'firebaseUid', 'userId', 'authEmail', 'portalAccessEnabled', 'lastLoginAt', 'updatedAt',
            'passwordHash', 'customPasswordHash', 'accessCodeHash', 'customPassword', 'accessCode', 'passcode', 'code',
            'forcePasswordReset', 'mustResetPassword', 'passwordUpdatedAt'
          ]));
      allow delete: if isAnyAdmin() || (isSchoolUser() && isSameSchool(resource.data.get('schoolId', null)));
    }
    match /students/{studentId} {
      allow read: if true;
      allow create: if isAnyAdmin() ||
        (isSchoolUser() && isSameSchool(request.resource.data.get('schoolId', null))) ||
        (isStaffOrTutor() && (isAssignedStaffToStudent(studentId) || hasStaffSchoolAccess(request.resource.data.get('schoolId', null))));
      allow update: if isAnyAdmin() ||
        (isSchoolUser() && isSameSchool(resource.data.get('schoolId', request.resource.data.get('schoolId', null)))) ||
        (isStaffOrTutor() && (isAssignedStaffToStudent(studentId) || hasStaffSchoolAccess(resource.data.get('schoolId', null)))) ||
        (isAuth() && (
          resource.data.get('firebaseUid', '') == request.auth.uid ||
          resource.data.get('userId', '') == request.auth.uid ||
          studentId == request.auth.uid ||
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('studentDocId', '') == studentId)
        )) ||
        (isAuth() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'firebaseUid', 'userId', 'authEmail', 'portalAccessEnabled', 'lastLoginAt', 'updatedAt',
            'passwordHash', 'customPasswordHash', 'accessCodeHash', 'customPassword', 'accessCode', 'passcode', 'code',
            'forcePasswordReset', 'mustResetPassword', 'passwordUpdatedAt'
          ]));
      allow delete: if isAnyAdmin() || (isSchoolUser() && isSameSchool(resource.data.get('schoolId', null)));
    }
    match /studentModules/{docId} { 
      allow read: if true; 
      allow create, update, delete: if isAnyAdmin() || isSchoolUser() || isStaffOrTutor() || isAuth(); 
    }
    match /personalResources/{docId} { 
      allow read: if true; 
      allow create, update, delete: if isAnyAdmin() || isSchoolUser() || isStaffOrTutor() || isAuth(); 
    }
    match /personalLinks/{docId} { 
      allow read: if true; 
      allow create, update, delete: if isAnyAdmin() || isSchoolUser() || isStaffOrTutor() || isAuth(); 
    }
    match /milestones/{milestoneId} {
      allow read: if true;
      allow create, update, delete: if isAnyAdmin() || isStaffOrTutor() || isSchoolUser() || isAuth();
    }
    match /assignments/{assignmentId} {
      allow read: if true;
      allow create, delete: if isAnyAdmin() || isStaffOrTutor() || isSchoolUser() || isAuth();
      allow update: if true;
    }
    match /certificates/{certId} {
      allow read: if true;
      allow write: if isAnyAdmin() || isStaffOrTutor() || isAuth();
    }
    match /achievements/{docId} {
      allow read: if true;
      allow write: if isAnyAdmin() || isStaffOrTutor() || isAuth();
    }
    match /studentAchievements/{docId} {
      allow read: if true;
      allow write: if isAnyAdmin() || isStaffOrTutor() || isAuth();
    }
    match /badges/{docId} {
      allow read: if true;
      allow write: if isAnyAdmin() || isStaffOrTutor() || isAuth();
    }
    match /typingScores/{docId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAnyAdmin();
    }
    match /schedules/{scheduleId} {
      allow read: if true;
      allow write: if isAnyAdmin() || isStaffOrTutor() || isSchoolUser() || isAuth();
    }
    match /student_schedules/{scheduleId} {
      allow read: if true;
      allow write: if isAnyAdmin() || isStaffOrTutor() || isSchoolUser() || isAuth();
    }
    match /liveClassrooms/{classId} {
      allow read: if true;
      allow write: if isAnyAdmin() || isStaffOrTutor() || isAuth();
    }
    match /liveClasses/{classId} {
      allow read: if true;
      allow write: if isAnyAdmin() || isStaffOrTutor() || isAuth();
    }
    match /assessments/{docId} {
      allow read: if true;
      allow write: if isAnyAdmin() || isStaffOrTutor() || isAuth();
    }
    match /academic_assessments/{docId} {
      allow read: if isAnyAdmin() || isStaffOrTutor() || isSchoolUser() || isAuth();
      allow write: if isAnyAdmin() || isStaffOrTutor() || isAuth();
    }
    match /attendance/{docId} {
      allow read: if isAnyAdmin() || isStaffOrTutor() || isSchoolUser() || isAuth();
      allow write: if isAnyAdmin() || isStaffOrTutor() || isAuth();
    }
    match /tutorAssignments/{docId} {
      allow read: if isAnyAdmin() || isStaffOrTutor() || isSchoolUser() || isAuth();
      allow write: if isAnyAdmin() || isStaffOrTutor();
    }
    match /staffAssignments/{docId} {
      allow read: if isAnyAdmin() || isStaffOrTutor() || isSchoolUser() || isAuth();
      allow write: if isAnyAdmin() || isStaffOrTutor();
    }
    match /studentAssignments/{docId} {
      allow read: if isAnyAdmin() || isStaffOrTutor() || isSchoolUser() || isAuth();
      allow write: if isAnyAdmin() || isStaffOrTutor();
    }
    match /learnerAssignments/{docId} {
      allow read: if isAnyAdmin() || isStaffOrTutor() || isSchoolUser() || isAuth();
      allow write: if isAnyAdmin() || isStaffOrTutor();
    }
    match /assessmentSubmissions/{docId} {
      // Legacy assessment submissions are accessed through authenticated server endpoints.
      allow read, write: if isAnyAdmin();
    }
    match /submissions/{docId} {
      // Legacy assignment submissions are accessed through authenticated server endpoints.
      allow read, write: if isAnyAdmin();
    }
    match /courses/{docId} {
      allow read: if true;
      allow write: if isAnyAdmin() || isStaffOrTutor();
    }
    match /resources/{resourceId} { allow read: if true; allow write, delete: if isStaffOrTutor() || isAnyAdmin(); }
    match /links/{linkId} { allow read: if true; allow write, delete: if isStaffOrTutor() || isAnyAdmin(); }
    match /exams/{examId} { allow read: if true; allow write, delete: if isStaffOrTutor() || isAnyAdmin(); }
    match /schoolResources/{resourceId} {
      allow read: if true;
      // School admins can manage resources for their own school. Tutors can
      // manage school resources only for schools assigned to them.
      allow create: if isAnyAdmin() ||
        (isSchoolUser() && isSameSchool(request.resource.data.get('schoolId', null))) ||
        (isStaffOrTutor() && hasStaffSchoolAccess(request.resource.data.get('schoolId', null)));
      allow update: if isAnyAdmin() ||
        (isSchoolUser() && isSameSchool(resource.data.get('schoolId', null)) && isSameSchool(request.resource.data.get('schoolId', null))) ||
        (isStaffOrTutor() && hasStaffSchoolAccess(resource.data.get('schoolId', null)) && hasStaffSchoolAccess(request.resource.data.get('schoolId', null)));
      allow delete: if isAnyAdmin() ||
        (isSchoolUser() && isSameSchool(resource.data.get('schoolId', null))) ||
        (isStaffOrTutor() && hasStaffSchoolAccess(resource.data.get('schoolId', null)));
    }
    match /schoolLinks/{linkId} { 
      allow read: if true; 
      allow create, update: if true; 
      allow delete: if isAnyAdmin() || hasStaffSchoolAccess(resource.data.schoolId) || isSameSchool(resource.data.schoolId); 
    }
    // Passcodes are verified and managed by trusted server functions only.
    // Direct client reads would expose passcode material to school users and
    // undermine the server-side attempt/rate-limit checks.
    match /schoolPasscodes/{docId} {
      allow read, write: if false;
    }
    match /staffGeneralResources/{resId} { allow read: if true; allow write, delete: if isStaffOrTutor() || isAnyAdmin(); }
    match /staffSchoolAccess/{docId} { allow read: if true; allow write: if isAnyAdmin(); }
    match /staffRegistration/{docId} { allow read, write: if true; }
    match /pendingStaff/{docId} { allow read: if true; allow write, delete: if isAnyAdmin(); }
    match /staff/{staffId} { allow read: if true; allow write: if isAnyAdmin() || (isAuth() && request.auth.uid == staffId); }
    match /parents/{parentId} { allow read: if isAnyAdmin() || (isAuth() && request.auth.uid == parentId); allow create: if isAuth() && request.auth.uid == parentId; allow update: if isAnyAdmin() || (isAuth() && request.auth.uid == parentId); allow delete: if isSuperAdmin() || isAnyAdmin() || (isAuth() && request.auth.uid == parentId); }
    
    match /payments/{paymentId} {
      allow read: if isAnyAdmin() || (isAuth() && (resource.data.userId == request.auth.uid || resource.data.parentId == request.auth.uid || resource.data.tutorId == request.auth.uid || resource.data.staffId == request.auth.uid || isSameSchool(resource.data.schoolId)));
      allow create: if isAnyAdmin() || isAuth();
      allow update, delete: if isAnyAdmin();
    }
    
    match /staffWallets/{staffId} {
      allow read: if isAnyAdmin() || (isAuth() && request.auth.uid == staffId);
      allow write: if isAnyAdmin() || (isAuth() && request.auth.uid == staffId);
    }
    
    match /withdrawals/{withdrawalId} {
      allow read: if isAnyAdmin() || (isAuth() && (resource.data.userId == request.auth.uid || resource.data.staffId == request.auth.uid || resource.data.tutorId == request.auth.uid));
      allow create: if isAuth() && (request.resource.data.userId == request.auth.uid || request.resource.data.staffId == request.auth.uid || isAnyAdmin());
      allow update, delete: if isAnyAdmin();
    }
    
    match /walletWithdrawals/{withdrawalId} {
      allow read: if isAnyAdmin() || (isAuth() && (resource.data.userId == request.auth.uid || resource.data.staffId == request.auth.uid || resource.data.tutorId == request.auth.uid));
      allow create: if isAuth() && (request.resource.data.userId == request.auth.uid || request.resource.data.staffId == request.auth.uid || isAnyAdmin());
      allow update, delete: if isAnyAdmin();
    }
    
    match /tutorSettlements/{settlementId} {
      allow read: if isAnyAdmin() || (isAuth() && resource.data.tutorId == request.auth.uid);
      allow write: if isAnyAdmin();
    }
    
    match /courseProgress/{docId} {
      allow read, write: if true;
    }
    match /studentProgress/{docId} {
      allow read, write: if true;
    }
    match /calendarEvents/{eventId} {
      allow read: if true;
      allow write: if isStaffOrTutor() || isAnyAdmin() || isSchoolUser() || isAuth();
    }
    
    match /enrollment_requests/{reqId} { 
      allow create: if isAuth(); 
      allow read: if isAnyAdmin() || (isAuth() && (resource.data.parentId == request.auth.uid || resource.data.parentEmail == request.auth.token.email || resource.data.parentId == null)); 
      allow update, delete: if isAnyAdmin() || (isAuth() && resource.data.parentId == request.auth.uid); 
    }
    match /enrollmentRequests/{reqId} { 
      allow create: if isAuth(); 
      allow read: if isAnyAdmin() || (isAuth() && (resource.data.parentId == request.auth.uid || resource.data.parentEmail == request.auth.token.email || resource.data.parentId == null)); 
      allow update, delete: if isAnyAdmin() || (isAuth() && resource.data.parentId == request.auth.uid); 
    }
    match /enrollments/{enrollmentId} {
      allow read: if isAnyAdmin() || isStaffOrTutor() || isSchoolUser() || (isAuth() && (resource.data.studentUid == request.auth.uid || resource.data.studentId == request.auth.uid || resource.data.parentId == request.auth.uid));
      allow create: if isAnyAdmin() || isSchoolUser() || isStaffOrTutor() || isAuth();
      allow update, delete: if isAnyAdmin() || isSchoolUser();
    }
    match /student_requests/{requestId} { 
      allow create: if isAuth() || true; 
      allow read: if isAnyAdmin() || (isAuth() && (resource.data.parentId == request.auth.uid || resource.data.parentEmail == request.auth.token.email || resource.data.email == request.auth.token.email)); 
      allow update, delete: if isAnyAdmin(); 
    }
    match /studentRequests/{requestId} { 
      allow create: if isAuth() || true; 
      allow read: if isAnyAdmin() || (isAuth() && (resource.data.parentId == request.auth.uid || resource.data.parentEmail == request.auth.token.email || resource.data.email == request.auth.token.email)); 
      allow update, delete: if isAnyAdmin(); 
    }
    match /supportTickets/{ticketId} {
      allow read: if isAnyAdmin() || (isAuth() && (resource.data.userId == request.auth.uid || resource.data.userEmail == request.auth.token.email));
      allow create, update: if isAuth();
      allow delete: if isAnyAdmin();
    }
    match /supportChats/{chatId} {
      allow read: if isAnyAdmin() || (isAuth() && (resource.data.userId == request.auth.uid || resource.data.userEmail == request.auth.token.email));
      allow create, update: if isAuth();
      allow delete: if isAnyAdmin();
    }
    match /tutorSubjectApplications/{appId} {
      allow create: if isAuth() && request.resource.data.tutorId == request.auth.uid;
      allow read: if isAnyAdmin() || (isAuth() && resource.data.tutorId == request.auth.uid);
      allow update: if isAnyAdmin() || (isAuth() && resource.data.tutorId == request.auth.uid && request.resource.data.tutorId == request.auth.uid);
      allow delete: if isAnyAdmin() || (isAuth() && resource.data.tutorId == request.auth.uid && resource.data.status == 'pending');
    }
    match /tutor_subject_applications/{appId} {
      allow create: if isAuth() && request.resource.data.tutorId == request.auth.uid;
      allow read: if isAnyAdmin() || (isAuth() && resource.data.tutorId == request.auth.uid);
      allow update: if isAnyAdmin() || (isAuth() && resource.data.tutorId == request.auth.uid && request.resource.data.tutorId == request.auth.uid);
      allow delete: if isAnyAdmin() || (isAuth() && resource.data.tutorId == request.auth.uid && resource.data.status == 'pending');
    }
    match /tutorSubjects/{subjectId} {
      allow read: if true;
      allow write: if isAnyAdmin() || isStaffOrTutor();
    }
    match /tutor_applications/{appId} {
      allow create: if true;
      allow read: if isAnyAdmin() || isAuth();
      allow update, delete: if isAnyAdmin();
    }
    match /tutorApplications/{appId} {
      allow create: if true;
      allow read: if isAnyAdmin() || isAuth();
      allow update, delete: if isAnyAdmin();
    }
    match /tutors/{tutorId} {
      allow read: if true;
      allow write: if isAnyAdmin() || isStaffOrTutor() || (isAuth() && request.auth.uid == tutorId);
    }
    // JDI examination records
    match /jdiExams/{examId} {
      allow read: if isAnyAdmin() || isStaffOrTutor() || isSchoolUser() || isAuth();
      allow create, update: if isAnyAdmin() || isStaffOrTutor();
      allow delete: if isAnyAdmin() || isStaffOrTutor();
    }
    match /schoolExams/{examId} {
      allow read: if isAnyAdmin() || isStaffOrTutor() || isSchoolUser() || isAuth();
      allow create, update: if isAnyAdmin() || isStaffOrTutor();
      allow delete: if isAnyAdmin() || isStaffOrTutor();
    }
    match /jdiExamAttempts/{attemptId} {
      allow read: if isAnyAdmin() || isStaffOrTutor() || isSchoolUser() || isAuth();
      allow create: if isAuth();
      allow update: if isAnyAdmin() || isStaffOrTutor() || isAuth();
      allow delete: if isAnyAdmin();
    }
    match /jdiQuestionBank/{questionId} {
      allow read: if isAnyAdmin() || isStaffOrTutor() || isSchoolUser();
      allow write: if isAnyAdmin() || isStaffOrTutor();
    }
    match /jdiAttemptLimits/{limitId} {
      allow read, write: if isAuth();
    }
    match /jdiPasscodeAttempts/{attemptId} {
      allow read, write: if isAuth();
    }
    match /jdiNotifications/{notificationId} {
      allow read: if isAnyAdmin() || isStaffOrTutor() || (isAuth() && (resource.data.get('recipientUid', '') == request.auth.uid || resource.data.get('userId', '') == request.auth.uid));
      allow create: if isAnyAdmin() || isStaffOrTutor();
      allow delete: if isAnyAdmin();
      allow update: if isAnyAdmin() || isStaffOrTutor() || (isAuth() && (resource.data.get('recipientUid', '') == request.auth.uid || resource.data.get('userId', '') == request.auth.uid));
    }
    match /notifications/{notificationId} {
      allow read: if isAuth();
      allow create: if isAnyAdmin() || isStaffOrTutor() || isSchoolUser() || isAuth();
      allow update: if isAnyAdmin() || isStaffOrTutor() || isAuth();
      allow delete: if isAnyAdmin();
    }
    match /activityLogs/{logId} { allow read: if isAnyAdmin(); allow write: if isAnyAdmin() || isAuth(); }
    match /treasuryLogs/{logId} { allow read, write: if isAnyAdmin(); }
    match /contact_messages/{msgId} { allow create: if true; allow read, update, delete: if isAnyAdmin(); }
    match /page_sections/{document=**} { allow read: if true; allow write: if isAnyAdmin(); }
    match /pages/{document=**} { allow read: if true; allow write: if isAnyAdmin(); }
    match /sections/{document=**} { allow read: if true; allow write: if isAnyAdmin(); }
    match /settings/{document=**} { allow read: if true; allow write: if isAnyAdmin(); }
    match /publicSettings/{document=**} { allow read: if true; allow write: if isAnyAdmin(); }
    match /payment_config/{document=**} { allow read: if true; allow write: if isAnyAdmin(); }
    match /programs/{document=**} { 
      allow read: if true;
      allow create, delete: if isAnyAdmin();
      allow update: if isAnyAdmin() || (isTutorOrSuperAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['curriculumPdfUrl','curriculumTitle','curriculumSummary','curriculum','topics','updatedAt']));
    }
    match /services/{document=**} { allow read: if true; allow write: if isAnyAdmin(); }
    match /portfolio/{document=**} { allow read: if true; allow write: if isAnyAdmin(); }
    match /kidsProjects/{document=**} { allow read: if true; allow write: if isAnyAdmin(); }
    match /blog/{document=**} { allow read: if true; allow write: if isAnyAdmin(); }
    match /newsCorner/{document=**} { allow read: if true; allow write: if isAnyAdmin(); }
    match /faqs/{document=**} { allow read: if true; allow write: if isAnyAdmin(); }
    match /testimonials/{document=**} { allow read: if true; allow write: if isAnyAdmin(); }
    match /schools/{schoolId} { 
      allow read: if true; 
      allow write: if isAnyAdmin() || (isAuth() && isSameSchool(schoolId)); 
    }
    match /schoolPrograms/{document=**} { allow read: if true; allow write: if isAnyAdmin() || isSchoolUser(); }
    match /classSchedules/{scheduleId} { 
      allow read: if isAnyAdmin() || isStaffOrTutor() || isSchoolUser() || isAuth(); 
      allow create, update, delete: if isAnyAdmin() || isStaffOrTutor() || isSchoolUser(); 
    }
    match /agreements/{agreementId} {
      allow read: if isAnyAdmin() || (
        isAuth() &&
        resource.data.get('status', 'DRAFT') != 'DRAFT' &&
        (
          resource.data.get('recipientId', '') == request.auth.uid ||
          (isSchoolUser() && isSameSchool(resource.data.get('recipientSchoolId', '')))
        )
      );
      allow create, delete: if isAnyAdmin();
      allow update: if isAnyAdmin() || (
        isAuth() &&
        (
          resource.data.get('recipientId', '') == request.auth.uid ||
          (isSchoolUser() && isSameSchool(resource.data.get('recipientSchoolId', '')))
        ) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'acknowledgedAt',
          'acknowledgedBy',
          'acknowledgedByName',
          'recipientNotes',
          'updatedAt',
          'auditLog'
        ])
      );
    }
    match /inquiries/{inquiryId} { allow create: if request.resource.data.keys().hasOnly(['name','email','phone','schoolName','type','role','programsOfInterest','message','source','createdAt']) && request.resource.data.name is string && request.resource.data.name.size() <= 120 && request.resource.data.email is string && request.resource.data.email.size() <= 254 && (!request.resource.data.keys().hasAny(['phone']) || (request.resource.data.phone is string && request.resource.data.phone.size() <= 40)) && (!request.resource.data.keys().hasAny(['schoolName']) || (request.resource.data.schoolName is string && request.resource.data.schoolName.size() <= 160)) && (!request.resource.data.keys().hasAny(['type']) || (request.resource.data.type is string && request.resource.data.type.size() <= 80)) && (!request.resource.data.keys().hasAny(['role']) || (request.resource.data.role is string && request.resource.data.role.size() <= 80)) && (!request.resource.data.keys().hasAny(['source']) || (request.resource.data.source is string && request.resource.data.source.size() <= 80)) && request.resource.data.message is string && request.resource.data.message.size() <= 5000; allow read, update, delete: if isAnyAdmin(); }
    match /{document=**} { allow read, write: if false; }
  }
}
